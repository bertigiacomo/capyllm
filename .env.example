# ==============================================================================
# CapyLLM — File di configurazione variabili d'ambiente (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SICUREZZA & CRITTOGRAFIA (Obbligatoria in produzione)
# ------------------------------------------------------------------------------
# Chiave master a 32+ caratteri usata con PBKDF2 (600.000 iterazioni) per
# crittografare a riposo con AES-256-GCM tutte le chiavi API upstream e i token segreti.
# Puoi generarne una con: openssl rand -hex 32
CAPY_MASTER_KEY="inserisci-una-chiave-segreta-di-almeno-32-caratteri"

# Segreto per la firma crittografica del cookie di sessione della dashboard (opzionale).
# Se omesso, viene utilizzato automaticamente il valore di CAPY_MASTER_KEY.
# CAPY_COOKIE_SECRET=""

# ------------------------------------------------------------------------------
# 2. SERVER & RETE
# ------------------------------------------------------------------------------
# Porta su cui ascolta il server CapyLLM (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 3. AUTENTICAZIONE WEBAUTHN / FIDO2 (PASSKEYS)
# ------------------------------------------------------------------------------
# URL completo del server visto dal browser (indispensabile per validare le Passkeys biometriche).
# In locale: http://localhost:3000
# In produzione con dominio: https://capy.tuodominio.com
CAPY_ORIGIN="http://localhost:3000"

# Identificativo Relying Party (dominio o hostname).
# Se omesso, viene dedotto automaticamente da CAPY_ORIGIN (es. localhost o capy.tuodominio.com).
# CAPY_RP_ID="localhost"

# Nome visualizzato durante il prompt biometrico (Touch ID, Face ID, Windows Hello)
CAPY_RP_NAME="CapyLLM"

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Percorso del file database SQLite (WAL mode). Default: ./data/capyllm.db
CAPY_DB_PATH="./data/capyllm.db"

# ------------------------------------------------------------------------------
# 5. NOTIFICHE TELEGRAM (Opzionali via .env — configurabili anche da UI)
# ------------------------------------------------------------------------------
# Puoi configurarle qui o direttamente dalla dashboard nella scheda "Impostazioni > Telegram".
# Se impostate sia nel database che qui, la configurazione da dashboard ha la precedenza.
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="-1001234567890"
# TELEGRAM_NOTIFICATIONS_ENABLED="true"
